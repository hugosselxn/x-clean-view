{
  "manifest_version": 3,
  "name": "X Clean View",
  "version": "1.3.0",
  "description": "Customize X's sidebar, floating buttons, and navigation.",
  "permissions": ["storage"],
  "action": {
    "default_title": "X Clean View settings",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["twitter-logo.svg"],
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
